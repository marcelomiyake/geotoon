{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "GeoToon chart values",
  "type": "object",
  "required": ["image", "service", "area", "overture", "photon", "duckdb", "rateLimits", "resources", "postgresql"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": "integer", "minimum": 30000, "maximum": 32767 }
      }
    },
    "area": {
      "type": "object",
      "required": ["radiusM"],
      "properties": {
        "radiusM": { "type": "integer", "minimum": 100, "maximum": 2000 }
      }
    },
    "overture": {
      "type": "object",
      "required": ["baseUrl", "release", "queryTimeoutSeconds"],
      "properties": {
        "baseUrl": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
        "queryTimeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 170 }
      }
    },
    "photon": {
      "type": "object",
      "required": ["url"],
      "properties": { "url": { "type": "string", "pattern": "^https?://" } }
    },
    "duckdb": {
      "type": "object",
      "required": ["memoryLimit", "threads"],
      "properties": {
        "memoryLimit": { "type": "string", "pattern": "^[0-9]+(MB|GB)$" },
        "threads": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    },
    "rateLimits": {
      "type": "object",
      "required": ["areasPerMinute", "geocodePerMinute"],
      "properties": {
        "areasPerMinute": { "type": "integer", "minimum": 1 },
        "geocodePerMinute": { "type": "integer", "minimum": 1 }
      }
    },
    "logLevel": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
    "resources": { "$ref": "#/definitions/resources" },
    "postgresql": {
      "type": "object",
      "required": ["image", "database", "user", "storage", "resources"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
        "storage": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$" },
        "storageClassName": { "type": "string" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["cpu", "memory"] }
      }
    }
  }
}
