# Copy to .env for `make dev`. Every value here is a safe local default.
PORT=8080
STATIC_DIR=apps/web/dist
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=geotoon
DATABASE_USER=geotoon
DATABASE_PASSWORD=local-dev-only
OVERTURE_BASE_URL=s3://overturemaps-us-west-2/release
OVERTURE_RELEASE=2026-10-21.0
OVERTURE_QUERY_TIMEOUT_S=120
AREA_RADIUS_M=2000
AREA_RADIUS_MAX_M=2000
PHOTON_URL=https://photon.komoot.io
PHOTON_TIMEOUT_MS=4000
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=4
DUCKDB_EXTENSION_DIR=
DUCKDB_TEMP_DIR=/tmp/duckdb
RATE_LIMIT_AREAS_PER_MIN=30
RATE_LIMIT_GEOCODE_PER_MIN=60
